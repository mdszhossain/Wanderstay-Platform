<% layout('/layouts/boilerplate') -%>
<body>
    <br>
    <div class="row">
        <div class="col-8 offset-2">
            <h3><%= listing.title %></h3>
        </div>
        <div class="card col-8 offset-2">
            <img src="<%= listing.image %>>" class="card-img-top show-image" alt="listing_image">  
            <br>
            <div class="card-body">
                <p class="card-text">
                    <%= listing.description %> <br><br>
                    <b>&#2547;<%= listing.price.toLocaleString("en-BN") %></b><br><br>
                    <%= listing.location %><br>
                    <%= listing.country %><br>
                </p>
            </div>
            <br>
        </div>
    </div>
    <div class="btns">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-2">Edit</a>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-dark offset-4 add-btn">Delete</button>
        </form>
    </div>
    <br>
    <div class="col-8 offset-2 mb-3">
        <hr>
        <h4>Leave a Review</h4>
        <form action="/listings/<%= listing._id%>/reviews" method="POST" novalidate class="needs-validation">
            <div class="mb-3 mt-3">
                <label class="form-label" for="rating">Rating</label>
                <input class="form-range" type="range" min="1" max="5" id="rating" name="review[rating]">
            </div>
            <div class="mb-3 mt-3">
                <label class="form-label" for="comment">Comments</label>
                <textarea name="review[comment]" id="comment" class="form-control" rows="5" required></textarea>
                <div class="invalid-feedback">please add some comment as review</div>
            </div>
            <button class="btn btn-outline-dark">Submit</button>
        </form>
    </div>

    <hr>

    <p><b>All Reviews</b></p>
    <div class="row">
        <%for(review of listing.reviews) {%>
            <div class="card review-card ms-3 col-5 mb-3 p-3">
                <div class="card-body">
                    <h5 class="card-title">Jane Doe</h5>
                    <p class="card-text"><%= review.comment %></p>
                    <p class="card-text"><%= review.rating %> stars</p>
                    <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </div>
            </div>
        <%}%>
    </div>
    
</body>
